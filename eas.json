{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GLOBE_STATS": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "benchmark": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_GLOBE_STATS": "1"
      }
    }
  }
}
