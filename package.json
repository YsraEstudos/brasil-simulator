{
  "name": "brasil-simulator",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@expo/vector-icons": "^15.0.2",
    "@react-three/fiber": "^9.8.1",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-gl": "~58.0.3",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "three": "^0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:globe": "python scripts/data/build_globe.py",
    "build:labels": "python scripts/data/build_labels.py",
    "build:cities": "python scripts/data/build_cities.py",
    "build:globe-climate": "python scripts/data/build_globe_climate.py",
    "build:climate": "python scripts/data/build_climatology.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim:balance": "vitest run --config vitest.balance.config.mts scripts/sim/balance.sim.ts",
    "sim:sensitivity": "vitest run --config vitest.balance.config.mts scripts/sim/sensitivity.sim.ts",
    "sim:reform": "vitest run --config vitest.balance.config.mts scripts/sim/reform.sim.ts",
    "sim:events": "vitest run --config vitest.balance.config.mts scripts/sim/events.sim.ts"
  },
  "private": true
}
